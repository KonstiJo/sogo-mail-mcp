# --- Required -----------------------------------------------------------
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
# Use an app password if your provider offers one
IMAP_PASSWORD=your-app-password

# --- Optional -----------------------------------------------------------
# Folder names differ per server ("Drafts" vs "INBOX.Drafts"); check with list_folders.
# DRAFTS_FOLDER=INBOX.Drafts
# TRASH_FOLDER=INBOX.Trash
# FROM_NAME=Your Name
# MAX_BODY_CHARS=20000

# Set to true to disable every write tool (drafts, flags, move, trash).
# READ_ONLY=false

# --- Dangerous actions (off by default; each call still asks YOU for confirmation) ---
# ALLOW_SEND=false
# ALLOW_DELETE=false
# SMTP_HOST=mail.example.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SENT_FOLDER=INBOX.Sent
